OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
SCENARIOFORGE_MODEL=
# Model requests (Agent and Python); no automatic retry on timeout or HTTP error.
MODEL_TIMEOUT_SECONDS=120
# Optional for system VPNs that map DNS to fake IPs in 198.18.0.0/15.
# Exact, server-admin-approved API hostnames only; leave unset by default.
# SCENARIOFORGE_MODEL_FAKE_IP_HOSTS=api.sudocode.chat
SCENARIOFORGE_MCP_URL=http://localhost:8000/mcp
# Replace the credentials and absolute CA path; URL-encode reserved password characters.
DATABASE_URL="mysql://project_app:replace-with-database-password@127.0.0.1:3307/projectdb?sslcert=/absolute/path/mysql-ca.pem&sslaccept=strict"
# Development browser origin; production must use its exact HTTPS origin.
SCENARIOFORGE_PUBLIC_ORIGIN=http://localhost:3000
# Generate a random secret and use the same value in both services.
SCENARIOFORGE_INTERNAL_TOKEN=replace-with-a-long-random-secret
# Server-only AES-256-GCM key: generate 32 random bytes, encode as base64, and back up privately.
# Keep this value stable; changing it in place makes saved project settings unreadable.
SCENARIOFORGE_SETTINGS_KEY=
SCENARIOFORGE_BACKEND_URL=http://localhost:3000

# Optional local development only: reuse server Git workspaces through an SSH tunnel.
# scripts/local-dev.ps1 sets these automatically when connected to projectdb.
# SCENARIOFORGE_REPOSITORY_BACKEND_URL=http://127.0.0.1:13000
# SCENARIOFORGE_REPOSITORY_BACKEND_ORIGIN=https://your-server.example

# ------------------------------------------
# Search Provider
# ------------------------------------------
# searxng = 自建或公共 SearXNG，推荐免费方案
# ddgs = DuckDuckGo 非官方搜索，需要 Python MCP Server
# tavily = Tavily Search API，需要 TAVILY_API_KEY
# mock = 本地假数据，不联网
SEARCH_PROVIDER=mock
SEARXNG_URL=http://localhost:8888
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
MAX_SEARCH_RESULTS_PER_QUESTION=5
SEARCH_TIMEOUT_MS=30000

# RAG: independent of chat settings; no OPENAI_API_KEY fallback.
RAG_ENABLED=false
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional; omit if unsupported by the provider.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT_CHARS=10000
