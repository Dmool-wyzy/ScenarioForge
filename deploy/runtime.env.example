NODE_ENV=production
SCENARIOFORGE_PUBLIC_ORIGIN=https://175.27.143.14
DATABASE_URL="mysql://project_app:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3307/projectdb?sslcert=/home/ubuntu/scenarioforge/deploy/private/mysql-ca.pem&sslaccept=strict"
SCENARIOFORGE_INTERNAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Server-only 32-byte random key encoded as base64; keep a private backup and do not rotate in place.
SCENARIOFORGE_SETTINGS_KEY=
SCENARIOFORGE_MCP_URL=http://127.0.0.1:8000/mcp
SCENARIOFORGE_BACKEND_URL=http://127.0.0.1:3000

# Optional server defaults. A saved project configuration takes precedence for new research rounds.
# Clearing a project configuration returns new rounds to these defaults, if configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
SCENARIOFORGE_MODEL=
MODEL_TIMEOUT_SECONDS=120
SEARCH_PROVIDER=mock
RAG_ENABLED=false
